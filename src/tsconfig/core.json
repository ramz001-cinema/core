{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2021",
		"module": "commonjs",
		"declaration": true,
		"strict": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": false,
		"outDir": "./dist",
		"rootDir": "./src"
	}
}